# Copy to .env. Never commit .env.

# NTRIP credentials (free registration at https://register.rtcm-ntrip.org/).
# Live ingestion is not implemented yet; these are read from phase 2 onwards.
# Leave empty to run in replay-only mode.
NTRIP_USER=
NTRIP_PASSWORD=

# Kafka bootstrap servers as seen from the host (containers use kafka:9092).
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
